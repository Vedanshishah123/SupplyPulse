# ASI:One API key (https://asi1.ai/dashboard/api-keys). Optional: onboarding falls back to a regex
# heuristic and emails to a template. With a key, extraction and email drafts use ASI:One.
ASI1_API_KEY=
# Seeds make agent addresses stable. Use a long random prefix in production and never change it.
AGENT_SEED_PREFIX=supplypulse-dev
# 1 = reach the orchestrator through Agentverse mailbox (needed for ASI:One), 0 = local only
USE_MAILBOX=1
# Optional data keys. Without them: financial signal and alternate-supplier search report "unavailable".
ALPHAVANTAGE_API_KEY=V8BWUZCYR1TATFLR
GEOAPIFY_API_KEY=
# Local payment testing only: skip the on-chain check of a payment (the amount is still checked). Default 0.
ALLOW_UNVERIFIED_PAYMENTS=0
# Payments are verified on the Fetch.ai testnet by default; set false for mainnet (real FET).
# FET_USE_TESTNET=true
# Testnet prices in FET (defaults 0.5 and 0.2)
# PRO_PRICE_FET=0.5
# DEEP_PRICE_FET=0.2
# Monitoring re-scan interval for Pro users in seconds (86400 = daily; use 60 for demos)
MONITOR_INTERVAL_S=86400
# Where sessions and plan entitlements are stored (default data/state.json)
# STATE_PATH=
# Free tier: how many suppliers get a free alternates/email preview (default 1)
# FREE_MITIGATION_PREVIEWS=1
